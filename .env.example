# DiscordianAI environment variables

# Discord bot token
# DISCORD_TOKEN=

# Comma-separated channel names
# ALLOWED_CHANNELS=

# Comma-separated channel IDs
# ALLOWED_CHANNEL_IDS=

# Comma-separated guild names or IDs used to scope channel-name matching
# ALLOWED_GUILDS=
# ALLOWED_GUILD_IDS=

# Bot presence and activity
# BOT_PRESENCE=online
# ACTIVITY_TYPE=listening
# ACTIVITY_STATUS=Humans

# OpenAI-compatible chat configuration (Ollama Cloud by default).
# OpenAI remains supported by changing these three values.
# OPENAI_API_KEY=your-ollama-cloud-api-key
# OPENAI_API_URL=https://ollama.com/v1/

# Perplexity configuration
# PERPLEXITY_API_KEY=
# PERPLEXITY_API_URL=https://api.perplexity.ai
# PERPLEXITY_MODEL=perplexity/sonar

# Default AI model and token limits
# GPT_MODEL=deepseek-v4.1-flash:1017
# Reasoning effort is model-defined (low|high|max for this model; none disables
# thinking). Reasoning tokens are billed as output.
# REASONING_EFFORT=high
# INPUT_TOKENS=250000
# OUTPUT_TOKENS=16384
# PERPLEXITY_OUTPUT_TOKENS=16384
# CONTEXT_WINDOW=1000000

# System prompt
# SYSTEM_MESSAGE=You are a helpful assistant.

# Native web tools for Ollama-compatible chat providers (ignored for OpenAI)
# WEB_TOOLS=true

# Image attachments (OpenAI-compatible chat provider only; never Perplexity)
# VISION_ENABLED=true
# VISION_MAX_IMAGES=4
# VISION_MAX_BYTES=5242880
# VISION_TOKEN_ESTIMATE=1000

# Rate limiting
# RATE_LIMIT=10
# RATE_LIMIT_PER=60

# Connection pooling
# OPENAI_MAX_CONNECTIONS=100
# OPENAI_MAX_KEEPALIVE=20
# PERPLEXITY_MAX_CONNECTIONS=40
# PERPLEXITY_MAX_KEEPALIVE=10

# Orchestrator settings
# LOOKBACK_MESSAGES_FOR_CONSISTENCY=6
# MAX_HISTORY_PER_USER=100
# CONVERSATION_TTL_SECONDS=7200
# USER_LOCK_CLEANUP_INTERVAL=3600
# ENTITY_DETECTION_MIN_WORDS=10
# Router: heuristic (default, deterministic) or clef (Ollama Cloud decision
# model, ~0.4 s per message and billed per token)
# ROUTER_MODE=heuristic
# Dedicated Clef decision-model key (preferred over the chat key). Only Ollama
# Cloud keys are eligible; unset falls back to OLLAMA_API_KEY.
# ROUTER_CLEF_API_KEY=
# ROUTER_CLEF_MODEL=clef
# ROUTER_CLEF_THRESHOLD=0.5
# ROUTER_CLEF_TIMEOUT_MS=2000

# Logging (LOG_FILE is deprecated and ignored; logs go to stderr)
# LOG_FILE=bot.log
# LOG_LEVEL=INFO
# DISCORDIANAI_LOG_COLOR=1  # Also configurable as [Logging] DISCORDIANAI_LOG_COLOR; set 0/false/no to disable

# Health endpoint
# HEALTH_ENABLED=true
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=8080
# Seconds after a provider's last success before /health marks it stale (diagnostic only)
# HEALTH_PROVIDER_STALE_SECONDS=300
