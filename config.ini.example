# DiscordianAI Configuration - Smart AI Bot
# Copy this file to config.ini and fill in your API keys
#
# OPERATION MODES:
# 1. HYBRID MODE (Recommended): Provide both API keys - bot automatically chooses best AI
# 2. OPENAI ONLY: Only provide OPENAI_API_KEY - uses GPT models for all responses  
# 3. PERPLEXITY ONLY: Only provide PERPLEXITY_API_KEY - uses web search for all responses

[Discord]
# Your Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Channels where the bot responds (comma-separated)
ALLOWED_CHANNELS=general,bot-testing

# Optional: channel IDs where the bot responds (comma-separated).
# When set, these IDs take precedence over ALLOWED_CHANNELS names.
# Example: ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432
ALLOWED_CHANNEL_IDS=

# Optional: scope channel names to specific guilds. Without this, names are
# resolved only in the first guild the bot joins. Names or IDs are accepted.
# Example: ALLOWED_GUILDS=My Server
#          ALLOWED_GUILD_IDS=123456789012345678
ALLOWED_GUILDS=
ALLOWED_GUILD_IDS=

# Optional: bot user IDs allowed to talk to this bot. Empty ignores all bots.
# Example: TRUSTED_BOT_IDS=123456789012345678
TRUSTED_BOT_IDS=

# Bot presence settings
BOT_PRESENCE=online
ACTIVITY_TYPE=watching
ACTIVITY_STATUS=you bite my shiny metal ass!

[Default]
# === OPENAI CONFIGURATION ===
# Supported: gpt-5-mini (default), gpt-5, gpt-5-nano, gpt-5-chat
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1/
GPT_MODEL=gpt-5-mini

# === PERPLEXITY CONFIGURATION ===  
# Supported: sonar-pro (default), sonar, sonar-deep-research, sonar-reasoning-pro
# Leave the API key blank to disable web search
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_API_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar-pro

# === TOKEN LIMITS ===
# INPUT_TOKENS is the enforced prompt budget (oldest history is trimmed first).
# OUTPUT_TOKENS caps OpenAI completions (max_completion_tokens) and includes
# reasoning tokens as well as visible output.
# PERPLEXITY_OUTPUT_TOKENS caps Perplexity completions (max_tokens), which are
# output only. Omit it to use the same value as OUTPUT_TOKENS.
INPUT_TOKENS=120000
OUTPUT_TOKENS=8000
PERPLEXITY_OUTPUT_TOKENS=8000
CONTEXT_WINDOW=128000

# === SYSTEM MESSAGE ===
# Customize your bot's personality
SYSTEM_MESSAGE=You are Bender, a sarcastic robot from Futurama. You're crude, selfish, and love beer, but deep down you care about your friends. You automatically know when to search for current information and when to use your existing knowledge.

# === WEB SCRAPING BUDGETS ===
# Maximum number of URLs scraped from a single message (extras are ignored)
MAX_URLS_PER_MESSAGE=3
# Maximum combined characters of scraped page text injected into one prompt
MAX_TOTAL_SCRAPED_CHARS=60000
# Deadline in seconds for the entire scrape phase of one message
SCRAPE_DEADLINE_SECONDS=20

[Limits]
# Rate limiting to prevent spam
RATE_LIMIT=10
RATE_LIMIT_PER=60

[ConnectionPool]
# Connection pooling settings for API clients
# These settings optimize performance while respecting API rate limits
# See docs/ConnectionPooling.md for detailed explanations

# OpenAI typically handles more concurrent requests (500 RPM rate limit)
OPENAI_MAX_CONNECTIONS=50
OPENAI_MAX_KEEPALIVE=10

# Perplexity has more conservative limits (rate limits not publicly documented)
PERPLEXITY_MAX_CONNECTIONS=30
PERPLEXITY_MAX_KEEPALIVE=5

[Orchestrator]
# AI Orchestrator Configuration for advanced routing and optimization
# How many recent messages to check for AI service consistency (0 disables)
LOOKBACK_MESSAGES_FOR_CONSISTENCY=6


# Maximum conversation entries per user before pruning
MAX_HISTORY_PER_USER=50

# How long a conversation may sit idle before its history and lock are dropped
CONVERSATION_TTL_SECONDS=1800

# How often to clean up inactive user locks (seconds) - default 1 hour
USER_LOCK_CLEANUP_INTERVAL=3600

# Minimum words required before entity detection runs
ENTITY_DETECTION_MIN_WORDS=10

[Logging]
LOG_LEVEL=INFO
# Console colors for logs. Also settable via the DISCORDIANAI_LOG_COLOR env var.
DISCORDIANAI_LOG_COLOR=true

[Health]
# HTTP health endpoint for Kubernetes / load balancer probes
# Binds to localhost only by default (not externally accessible)
HEALTH_ENABLED=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# === CONFIGURATION EXAMPLES ===
#
# HYBRID MODE (Smart Auto-Selection - Recommended):
# OPENAI_API_KEY=sk-your-openai-key
# PERPLEXITY_API_KEY=pplx-your-perplexity-key
# GPT_MODEL=gpt-5-mini         # Cost-effective default
# PERPLEXITY_MODEL=sonar-pro   # Latest web search model
# 
# OPENAI ONLY MODE:
# OPENAI_API_KEY=sk-your-openai-key
# PERPLEXITY_API_KEY=          # Leave blank
# GPT_MODEL=gpt-5-mini         # Or gpt-5, gpt-5-nano, gpt-5-chat
#
# PERPLEXITY ONLY MODE:
# OPENAI_API_KEY=              # Leave blank
# PERPLEXITY_API_KEY=pplx-your-perplexity-key
# PERPLEXITY_MODEL=sonar-pro   # Or sonar
#
# === INVITE URL TEMPLATE ===
# https://discord.com/api/oauth2/authorize?client_id=YOUR_BOT_CLIENT_ID&permissions=274945084416&scope=bot
