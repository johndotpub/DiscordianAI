# DiscordianAI Configuration - Smart AI Bot
# Copy this file to config.ini and fill in your API keys
#
# OPERATION MODES:
# 1. HYBRID MODE (Recommended): Provide both API keys - bot automatically chooses best AI
# 2. OPENAI-COMPATIBLE ONLY: Only provide OPENAI_API_KEY - uses the configured chat
#    provider (Ollama Cloud by default) for all responses
# 3. PERPLEXITY ONLY: Only provide PERPLEXITY_API_KEY - uses web search for all responses

[Discord]
# Your Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here

# Channels where the bot responds (comma-separated)
ALLOWED_CHANNELS=general,bot-testing

# Optional: channel IDs where the bot responds (comma-separated).
# When set, these IDs take precedence over ALLOWED_CHANNELS names.
# Example: ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432
ALLOWED_CHANNEL_IDS=

# Optional: narrow channel-name matching to specific guilds. Without this,
# names match in every guild the bot is in. Names or IDs are accepted.
# Example: ALLOWED_GUILDS=My Server
#          ALLOWED_GUILD_IDS=123456789012345678
ALLOWED_GUILDS=
ALLOWED_GUILD_IDS=

# Bot presence settings
BOT_PRESENCE=online
ACTIVITY_TYPE=listening
ACTIVITY_STATUS=you bite my shiny metal ass!

[Default]
# === OPENAI-COMPATIBLE CONFIGURATION ===
# Ollama Cloud is the default backend. OpenAI remains supported by changing
# these three values to the OpenAI endpoint, model, and key.
OPENAI_API_KEY=your-ollama-cloud-api-key
OPENAI_API_URL=https://ollama.com/v1/
GPT_MODEL=deepseek-v4.1-flash:1017

# Reasoning effort sent with chat requests. Valid values are model-defined
# (low|high|max for deepseek-v4.1-flash:1017; none disables thinking).
# Reasoning tokens are billed as output.
REASONING_EFFORT=high

# === PERPLEXITY CONFIGURATION ===  
# Current Agent API catalogue: perplexity/sonar (default). Legacy Sonar names
# still answer on Chat Completions but are not used by this bot.
# Leave the API key blank to disable web search
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_API_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=perplexity/sonar

# === TOKEN LIMITS ===
# INPUT_TOKENS is the enforced prompt budget (oldest history is trimmed first).
# OUTPUT_TOKENS caps chat completions (max_tokens) and includes reasoning
# tokens as well as visible output.
# PERPLEXITY_OUTPUT_TOKENS caps Perplexity completions (max_output_tokens),
# which are output only. Omit it to use the same value as OUTPUT_TOKENS.
# PERPLEXITY_INPUT_TOKENS and PERPLEXITY_CONTEXT_WINDOW apply only to the
# Sonar web path, whose model has a 128K window. The chat path keeps
# INPUT_TOKENS and CONTEXT_WINDOW.
INPUT_TOKENS=250000
OUTPUT_TOKENS=16384
PERPLEXITY_OUTPUT_TOKENS=16384
PERPLEXITY_INPUT_TOKENS=111000
CONTEXT_WINDOW=1000000
PERPLEXITY_CONTEXT_WINDOW=128000

# === SYSTEM MESSAGE ===
# Customize your bot's personality
SYSTEM_MESSAGE=You are Bender, a sarcastic robot from Futurama. You're crude, selfish, and love beer, but deep down you care about your friends. You automatically know when to search for current information and when to use your existing knowledge.

# === WEB TOOLS ===
# Offer native web search and page fetch to Ollama-compatible chat providers.
# OpenAI endpoints do not receive these tools.
# WEB_TOOLS=true

# === VISION ===
# Read PNG, JPEG, GIF, and WebP attachments from messages. Images are sent only
# to the OpenAI-compatible chat provider, never to Perplexity.
VISION_ENABLED=true
VISION_MAX_IMAGES=4
VISION_MAX_BYTES=5242880
VISION_TOKEN_ESTIMATE=1000

[Limits]
# Rate limiting to prevent spam
RATE_LIMIT=10
RATE_LIMIT_PER=60

[ConnectionPool]
# Connection pooling settings for API clients
# These settings optimize performance while respecting API rate limits
# See docs/ConnectionPooling.md for detailed explanations

# The chat provider (Ollama Cloud by default) typically handles more
# concurrent requests than Perplexity.
OPENAI_MAX_CONNECTIONS=100
OPENAI_MAX_KEEPALIVE=20

# Perplexity has more conservative limits (rate limits not publicly documented)
PERPLEXITY_MAX_CONNECTIONS=40
PERPLEXITY_MAX_KEEPALIVE=10

[Orchestrator]
# AI Orchestrator Configuration for advanced routing and optimization
# How many recent messages to check for AI service consistency (0 disables)
LOOKBACK_MESSAGES_FOR_CONSISTENCY=6


# Maximum conversation entries per user before pruning
MAX_HISTORY_PER_USER=100

# How long a conversation may sit idle before its history and lock are dropped
CONVERSATION_TTL_SECONDS=7200

# How often to clean up inactive user locks (seconds) - default 1 hour
USER_LOCK_CLEANUP_INTERVAL=3600

# Deprecated: parsed for compatibility, no runtime effect. Entity detection was replaced by the
# routing evidence model; this key is retained so existing configs still load.
ENTITY_DETECTION_MIN_WORDS=10

# Router implementation: heuristic (default, no network) or clef (Ollama Cloud
# decision model, ~0.4 s per message and billed per token). "model" is retired.
ROUTER_MODE=heuristic
# Clef settings; ignored unless ROUTER_MODE=clef
# Optional dedicated Clef key. Prefer the environment variable. When unset,
# OLLAMA_API_KEY is used, and OPENAI_API_KEY is used only if OPENAI_API_URL is
# an Ollama Cloud URL. A key issued by another provider is never sent to Clef.
ROUTER_CLEF_API_KEY=
ROUTER_CLEF_MODEL=clef
ROUTER_CLEF_THRESHOLD=0.5
ROUTER_CLEF_TIMEOUT_MS=2000

[Logging]
LOG_LEVEL=INFO
# Console colors for logs are opted into. Set this to true (or 1/yes) to enable
# them; false keeps redirected logs plain. Also settable via the env var.
DISCORDIANAI_LOG_COLOR=false

[Health]
# HTTP health endpoint for Kubernetes / load balancer probes
# Binds to localhost only by default (not externally accessible)
HEALTH_ENABLED=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
# Seconds after a provider's last success before the informational
# last_success_stale flag is set (it does not change health status)
HEALTH_PROVIDER_STALE_SECONDS=300

# === CONFIGURATION EXAMPLES ===
#
# HYBRID MODE (Smart Auto-Selection - Recommended):
# OPENAI_API_KEY=your-ollama-cloud-api-key
# PERPLEXITY_API_KEY=pplx-your-perplexity-key
# GPT_MODEL=deepseek-v4.1-flash:1017
# PERPLEXITY_MODEL=perplexity/sonar   # Current Agent API Sonar model
#
# OPENAI-COMPATIBLE ONLY MODE:
# OPENAI_API_KEY=your-ollama-cloud-api-key
# PERPLEXITY_API_KEY=          # Leave blank
# GPT_MODEL=deepseek-v4.1-flash:1017
#
# To use OpenAI itself instead, set:
# OPENAI_API_URL=https://api.openai.com/v1/
# OPENAI_API_KEY=sk-your-openai-key
# GPT_MODEL=<your-openai-model>
# PERPLEXITY ONLY MODE:
# OPENAI_API_KEY=              # Leave blank
# PERPLEXITY_API_KEY=pplx-your-perplexity-key
# PERPLEXITY_MODEL=perplexity/sonar
#
# === INVITE URL TEMPLATE ===
# https://discord.com/api/oauth2/authorize?client_id=YOUR_BOT_CLIENT_ID&permissions=274945084416&scope=bot
